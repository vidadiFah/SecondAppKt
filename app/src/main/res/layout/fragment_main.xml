<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/bg_gray"
    android:fitsSystemWindows="true"
    tools:context=".ui.main.MainFragment">

    <TextView
        android:id="@+id/tvAllNotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Все заметки"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:id="@+id/btn_menu"
        android:padding="12dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_menu"
        app:layout_constraintBottom_toBottomOf="@id/tvAllNotes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAllNotes"
        app:tint="@color/gray" />

    <ImageView
        android:id="@+id/btn_change_layout"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:padding="9dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_grid"
        app:layout_constraintBottom_toBottomOf="@id/tvAllNotes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAllNotes"
        app:tint="@color/gray"/>

    <ImageView
        android:id="@+id/btn_calendar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="6dp"
        android:src="@drawable/ic_calendar"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@id/tvAllNotes"
        app:layout_constraintStart_toEndOf="@id/tvAllNotes"
        app:layout_constraintTop_toTopOf="@id/tvAllNotes"
        app:tint="@color/calendar" />

    <ImageView
        android:id="@+id/iv_search_note"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/rounded_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAllNotes"
        app:tint="@color/search_gray" />

    <ImageView
        android:id="@+id/iv_search_sign"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="18dp"
        android:src="@drawable/ic_search_sign"
        app:layout_constraintBottom_toBottomOf="@id/iv_search_note"
        app:layout_constraintStart_toStartOf="@id/iv_search_note"
        app:layout_constraintTop_toTopOf="@id/iv_search_note" />

    <EditText
        android:id="@+id/et_search_note"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="11dp"
        android:background="@android:color/transparent"
        android:textColor="@color/white"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_search_note"
        app:layout_constraintEnd_toEndOf="@id/iv_search_note"
        app:layout_constraintStart_toEndOf="@id/iv_search_sign"
        app:layout_constraintTop_toTopOf="@id/iv_search_note" />

    <TextView
        android:id="@+id/tv_search_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Поиск заметок"
        android:textColor="@color/gray"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_search_note"
        app:layout_constraintStart_toEndOf="@id/iv_search_sign"
        app:layout_constraintTop_toTopOf="@id/iv_search_note" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_notes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_search_note"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="6dp"
        tools:listitem="@layout/item_note" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fb_create"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/orange"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_plus"
        app:tint="@color/white" />

    <View
        android:id="@+id/vDarkLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_delete_note_main"
        android:layout_width="320dp"
        android:layout_height="130dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/rounded_bg"
            app:tint="@color/search_gray" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Удалить заметку?"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_decline_main_frag_dialog"
                android:layout_width="128dp"
                android:layout_height="48dp"
                android:background="@drawable/decline_rounded_bg"
                android:text="Отмена"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_main_frag_dialog"
                android:layout_width="128dp"
                android:layout_height="48dp"
                android:layout_marginStart="22dp"
                android:background="@drawable/accept_rounded_bg"
                android:text="Удалить"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/orange" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/vDarkLayer_menu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#A6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:id="@+id/con_menu"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/menu_bg_gray"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@color/orange"
            android:id="@+id/iv_user_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="14dp"
            android:layout_marginStart="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username"
            android:id="@+id/tv_user_name"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:layout_constraintTop_toTopOf="@id/iv_user_avatar"
            app:layout_constraintBottom_toBottomOf="@id/iv_user_avatar"
            app:layout_constraintStart_toEndOf="@id/iv_user_avatar"
            android:layout_marginStart="14dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0.6dp"
            android:background="@color/gray_dark"
            android:id="@+id/v_menu_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_user_avatar"
            android:layout_marginTop="14dp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:id="@+id/btn_logout"
            app:layout_constraintTop_toTopOf="@id/v_menu_line">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:id="@+id/iv_logout_sign"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/logout_icon"
                android:layout_marginStart="16dp"
                app:tint="@color/gray_dark_2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textColor="@color/white"
                android:textSize="18dp"
                app:layout_constraintStart_toEndOf="@id/iv_logout_sign"
                app:layout_constraintTop_toTopOf="@id/iv_logout_sign"
                app:layout_constraintBottom_toBottomOf="@id/iv_logout_sign"
                android:layout_marginStart="10dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>